{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Energomera meter (BLE)",
        "description": "Select your meter by its serial number (printed on the case and in the meter's passport) and enter the PIN — the 6-digit \"BLE radio interface password\" from the passport. The CE901 display unit shows it as well.",
        "data": {
          "address": "Meter",
          "pin": "PIN (BLE password)"
        }
      },
      "bluetooth_confirm": {
        "title": "Found meter {name}",
        "description": "Enter the PIN — the 6-digit \"BLE radio interface password\" from the meter's passport. The CE901 display unit shows it as well.",
        "data": {
          "pin": "PIN (BLE password)"
        }
      },
      "reauth_confirm": {
        "title": "The meter rejected the PIN",
        "description": "Meter {name} no longer accepts the stored PIN — the BLE password was probably changed. Enter the current PIN.",
        "data": {
          "pin": "PIN (BLE password)"
        }
      },
      "reconfigure": {
        "title": "Change PIN",
        "description": "New PIN for meter {name}. The meter will be paired again.",
        "data": {
          "pin": "PIN (BLE password)"
        }
      }
    },
    "error": {
      "invalid_pin": "The meter rejected the PIN. Check the BLE password in the passport.",
      "pairing_failed": "Pairing failed (weak signal or the meter is busy). Please try again.",
      "cannot_connect": "Could not read data from the meter. Please try again — the signal is weak."
    },
    "abort": {
      "no_devices_found": "No CE208/CE308 meters found over Bluetooth.",
      "already_configured": "This meter is already configured.",
      "already_in_progress": "This meter is already being set up.",
      "not_supported": "This device is not supported.",
      "reauth_successful": "PIN updated, the meter is being polled again.",
      "reconfigure_successful": "PIN changed.",
      "discovery_disabled": "Discovery of other meters is turned off in the integration options."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling options",
        "data": {
          "scan_interval": "Polling interval, seconds",
          "imbalance_threshold": "Phase imbalance threshold, A",
          "breaker_rating": "Main breaker rating, A",
          "allocated_power": "Allocated power, kW",
          "discover_others": "Offer to add other discovered meters"
        },
        "data_description": {
          "scan_interval": "How often to read the meter. Polling too often with a weak signal causes more errors.",
          "imbalance_threshold": "\"Phase imbalance\" turns on when the current difference between the most and least loaded phase is at least this value for two polls in a row.",
          "breaker_rating": "For the \"Phase L1–L3 load\" sensors — phase current in % of the breaker rating. 0 hides them.",
          "allocated_power": "Contracted power from your grid connection agreement. For the \"Allocated power load\" sensor. 0 hides it.",
          "discover_others": "When off, Home Assistant will not show \"Discovered\" cards for other meters nearby (e.g. neighbours on the same pole). You can always add another meter of your own manually with \"Add entry\"."
        }
      }
    }
  },
